@{
    ViewData["Title"] = "Admin Login";
}

<style>
    .admin-login-page {
        max-width: 980px;
        margin: 0 auto;
        padding: 34px 18px 80px;
    }

    .admin-login-hero {
        position: relative;
        overflow: hidden;
        border-radius: 34px;
        padding: 46px 42px 128px;
        margin-bottom: -88px;
        color: white;
        background:
            radial-gradient(circle at 86% 14%, rgba(255,255,255,0.10), transparent 30%),
            radial-gradient(circle at 14% 18%, rgba(239,35,60,0.45), transparent 33%),
            linear-gradient(135deg, #121826 0%, #24283f 46%, #090b10 100%);
        box-shadow: 0 30px 85px rgba(0,0,0,0.35);
    }

    .admin-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 28px;
    }

    .admin-logo {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        background: #ef233c;
        color: white;
        font-weight: 950;
        letter-spacing: -0.6px;
        box-shadow: 0 14px 30px rgba(239,35,60,0.34);
    }

    .admin-brand span {
        font-weight: 950;
        font-size: 19px;
    }

    .admin-login-hero h1 {
        max-width: 720px;
        font-size: clamp(44px, 6vw, 78px);
        line-height: 0.95;
        letter-spacing: -2.4px;
        font-weight: 950;
        margin-bottom: 18px;
    }

    .admin-login-hero p {
        max-width: 620px;
        color: rgba(255,255,255,0.82);
        font-size: 18px;
        font-weight: 750;
        margin: 0;
    }

    .login-panel {
        position: relative;
        z-index: 4;
        max-width: 560px;
        margin: 0 auto;
        border-radius: 30px;
        overflow: hidden;
        background:
            linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.012)),
            rgba(15,23,42,0.95);
        border: 1px solid rgba(255,255,255,0.14);
        box-shadow: 0 28px 80px rgba(0,0,0,0.32);
        color: white;
    }

    .login-panel-header {
        padding: 20px 26px;
        background: rgba(255,255,255,0.06);
        border-bottom: 1px solid rgba(255,255,255,0.12);
    }

    .login-panel-header h2 {
        margin: 0;
        font-size: 24px;
        font-weight: 950;
        letter-spacing: -0.5px;
    }

    .login-panel-body {
        padding: 26px;
    }

    .login-field {
        margin-bottom: 16px;
    }

    .login-field label {
        display: block;
        color: rgba(255,255,255,0.78);
        font-weight: 900;
        margin-bottom: 8px;
    }

    .login-field input {
        width: 100%;
        height: 54px;
        border-radius: 16px;
        border: 1px solid rgba(255,255,255,0.16);
        background: rgba(2,6,23,0.34);
        color: white;
        padding: 0 15px;
        font-weight: 850;
        outline: none;
    }

    .login-field input:focus {
        border-color: rgba(239,35,60,0.72);
        box-shadow: 0 0 0 4px rgba(239,35,60,0.12);
    }

    .login-btn {
        width: 100%;
        min-height: 60px;
        border: 0;
        border-radius: 18px;
        background: linear-gradient(180deg, #ff2342, #e0001b);
        color: white;
        font-size: 18px;
        font-weight: 950;
        box-shadow: 0 18px 38px rgba(239,35,60,0.30);
        transition: all .18s ease;
    }

    .login-btn:hover {
        transform: translateY(-2px);
        filter: brightness(1.04);
    }

    .login-error {
        border-radius: 16px;
        padding: 13px 15px;
        background: rgba(239,68,68,0.13);
        border: 1px solid rgba(239,68,68,0.28);
        color: #fecaca;
        font-weight: 850;
        margin-bottom: 16px;
    }

    .login-note {
        margin-top: 16px;
        color: rgba(255,255,255,0.55);
        font-weight: 800;
        font-size: 13px;
    }
</style>

<div class="admin-login-page">
    <section class="admin-login-hero">
        <div class="admin-brand">
            <div class="admin-logo">RG</div>
            <span>RailGo</span>
        </div>

        <h1>Administrare RailGo.</h1>

        <p>
            Accesează panoul de analiză pentru rezervări, venituri și gradul de ocupare al trenurilor.
        </p>
    </section>

    <section class="login-panel">
        <div class="login-panel-header">
            <h2>Autentificare administrator</h2>
        </div>

        <div class="login-panel-body">
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="login-error">
                    @ViewBag.ErrorMessage
                </div>
            }

            <form asp-controller="Admin" asp-action="Login" method="post">
                <div class="login-field">
                    <label>Utilizator</label>
                    <input type="text" name="username" value="admin" autocomplete="off" />
                </div>

                <div class="login-field">
                    <label>Parolă</label>
                    <input type="password" name="password" value="admin" autocomplete="off" />
                </div>

                <button type="submit" class="login-btn">
                    Intră în dashboard
                </button>
            </form>

            <div class="login-note">
                Cont demonstrativ: admin / admin
            </div>
        </div>
    </section>
</div>